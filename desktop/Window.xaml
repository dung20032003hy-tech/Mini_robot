<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WALL-E Control · 4 Motor &amp; AI" Width="1280" Height="850" MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0B1018" Foreground="#EFF4FC"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#253246"/><Setter Property="Foreground" Value="#EEF4FF"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,11"/>
      <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#F4C348"/><Setter Property="Foreground" Value="#161C25"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#AD343E"/><Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="Padding" Value="17,14"/><Setter Property="Background" Value="#171F2C"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#141D2A"/><Setter Property="BorderBrush" Value="#263348"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,16,16"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#9DAFC5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D7E3F4"/><Setter Property="Margin" Value="0,8,0,14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Slider"><Setter Property="Margin" Value="0,12,0,17"/><Setter Property="Foreground" Value="#F4C348"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1420"/><Setter Property="Foreground" Value="#F0F4FA"/><Setter Property="BorderBrush" Value="#3B4B61"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="6"/><Setter Property="Background" Value="#28364A"/><Setter Property="Foreground" Value="#F4C348"/><Setter Property="Maximum" Value="100"/><Setter Property="Margin" Value="0,5,0,13"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#111925" BorderBrush="#253044" BorderThickness="0,0,1,0" Padding="18,28">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="UpdateFirmware" Content="Cập nhật firmware USB" FontSize="12" Padding="10,12" Margin="0,0,0,12"/>
          <TextBlock Text="ESP32-S3 · N16R8" Foreground="#D3DFEF" FontSize="12"/>
          <TextBlock Text="16 MB Flash / 8 MB PSRAM" Foreground="#798FA9" FontSize="11" Margin="0,5,0,0"/>
          <TextBlock Text="USB trực tiếp · 115200" Foreground="#798FA9" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel>
          <Border Background="#F4C348" CornerRadius="12" Width="54" Height="44" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="15" Height="13" Background="#17202D" CornerRadius="5" Margin="0,0,4,0"/>
              <Border Width="15" Height="13" Background="#17202D" CornerRadius="5"/>
            </StackPanel>
          </Border>
          <TextBlock Text="WALL-E" FontSize="29" FontWeight="Bold" Margin="0,15,0,0"/>
          <TextBlock Text="ROBOT CONTROL" FontSize="10" Foreground="#8D9FB6" Margin="0,4,0,28"/>
          <Button x:Name="NavDrive" Content="01    4 động cơ DC" Style="{StaticResource Nav}" Background="#2E3A4C"/>
          <Button x:Name="NavArms" Content="02    Hai cánh tay" Style="{StaticResource Nav}"/>
          <Button x:Name="NavEyes" Content="03    Mắt &amp; âm thanh" Style="{StaticResource Nav}"/>
          <Button x:Name="NavAi" Content="04    Trợ lý AI" Style="{StaticResource Nav}"/>
          <Button x:Name="NavSettings" Content="05    Cấu hình" Style="{StaticResource Nav}"/>
          <TextBlock Text="ĐIỀU KHIỂN MOTOR" FontSize="10" Foreground="#687D99" Margin="12,28,0,8"/>
          <TextBlock Text="Giữ 1–4: quay thuận&#10;Shift + 1–4: quay nghịch&#10;ESC để dừng khẩn" Foreground="#A5B5C9" FontSize="12" Margin="12,0,0,0" LineHeight="23"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="28,20,12,12">
      <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
      <Grid Margin="0,0,16,0">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="4 động cơ DC độc lập" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Kết nối USB. Quan sát trạng thái. Điều khiển theo ý bạn." Foreground="#9DAFC5" Margin="0,6,0,0"/>
        </StackPanel>
        <Button x:Name="Emergency" Content="●  DỪNG KHẨN  /  ESC" Style="{StaticResource Danger}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" Padding="20,14"/>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,16,12">
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="Cổng USB" Foreground="#A5B5C9" VerticalAlignment="Center" Margin="0,0,10,8"/>
          <ComboBox x:Name="Port" IsEditable="True" Text="COM6" Width="92" Height="35" VerticalAlignment="Top" Foreground="#182334" Margin="0,0,8,8"/>
          <Button x:Name="Refresh" Content="↻" Padding="12,8" ToolTip="Quét cổng COM"/>
          <Button x:Name="Connect" Content="Kết nối" Style="{StaticResource Primary}" Padding="16,9"/>
          <Button x:Name="Disconnect" Content="Ngắt" Padding="13,9"/>
          <Border Background="#0C1420" CornerRadius="8" Padding="13,8" Margin="3,0,10,8">
            <TextBlock x:Name="ConnectionState" Text="●  Chưa kết nối" Foreground="#91A4BB" VerticalAlignment="Center"/>
          </Border>
          <Button x:Name="Claim" Content="Nhận quyền" Padding="13,9"/>
          <Button x:Name="Release" Content="Trả quyền" Padding="13,9"/>
        </WrapPanel>
      </Border>
      <Border Grid.Row="2" Background="#1E2838" CornerRadius="8" Margin="0,0,16,14" Padding="13,10">
        <TextBlock x:Name="Feedback" Text="Cắm ESP32, chọn cổng COM rồi bấm Kết nối. Lần đầu sử dụng: cập nhật firmware USB." Foreground="#C4D4E9" TextWrapping="Wrap"/>
      </Border>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Grid x:Name="DrivePage">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                <DockPanel><TextBlock x:Name="LockStatus" Text="ĐỘNG CƠ ĐANG KHÓA" FontWeight="Bold" Foreground="#F4C348"/><TextBlock x:Name="PwmLimit" Text="PWM giới hạn: —" HorizontalAlignment="Right"/></DockPanel>
                <CheckBox x:Name="WheelsClear" Margin="0,10,0,10"><TextBlock Text="Đã cố định cơ cấu và kiểm tra vùng quay của cả 4 motor." TextWrapping="Wrap"/></CheckBox>
                <WrapPanel>
                  <Button x:Name="Arm" Content="Mở khóa động cơ" Style="{StaticResource Primary}"/>
                  <Button x:Name="Stop" Content="DỪNG TẤT CẢ" Style="{StaticResource Danger}"/>
                  <Button x:Name="ResetEstop" Content="Reset dừng khẩn"/>
                  <Button x:Name="JumpCombination" Content="Tổ hợp ↓"/>
                  <Button x:Name="JumpSequence" Content="Chuỗi thời gian ↓"/>
                </WrapPanel>
                <TextBlock x:Name="HardwareHint" Text="Chỉ mở khóa sau khi xác nhận phần cứng trong Cấu hình." Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
              </StackPanel></Border>
              <TextBlock Text="Giữ Thuận / Nghịch để chạy riêng từng motor. Thả nút để dừng." Style="{StaticResource Muted}"/>
              <UniformGrid x:Name="MotorChannels" Columns="4"/>
              <Border x:Name="MotorCombinationSection" Style="{StaticResource Card}" Padding="16"><StackPanel>
                <TextBlock Text="Chạy theo tổ hợp" Style="{StaticResource Title}"/>
                <TextBlock Text="Chọn Tắt / Thuận / Nghịch trong từng ô motor phía trên. Các motor có thể khác chiều và khác mức công suất." Style="{StaticResource Muted}" FontSize="12"/>
                <WrapPanel>
                  <Button x:Name="PresetAll" Content="Cả 4 thuận" Padding="12,8"/>
                  <Button x:Name="PresetReverse" Content="Cả 4 nghịch" Padding="12,8"/>
                  <Button x:Name="Preset12" Content="M1 + M2" Padding="12,8"/>
                  <Button x:Name="Preset34" Content="M3 + M4" Padding="12,8"/>
                  <Button x:Name="Preset13" Content="M1 + M3" Padding="12,8"/>
                  <Button x:Name="Preset24" Content="M2 + M4" Padding="12,8"/>
                  <Button x:Name="Preset14" Content="M1 + M4" Padding="12,8"/>
                  <Button x:Name="Preset23" Content="M2 + M3" Padding="12,8"/>
                  <Button x:Name="PresetInvert" Content="Đảo chiều" Padding="12,8"/>
                  <Button x:Name="PresetNone" Content="Tắt cả 4" Padding="12,8"/>
                </WrapPanel>
                <TextBlock x:Name="MotorCombination" Text="Chưa chọn motor trong tổ hợp." Foreground="#9DAFC5" TextWrapping="Wrap" Margin="0,2,0,10"/>
                <Button x:Name="RunCombination" Content="GIỮ ĐỂ CHẠY TỔ HỢP" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
              </StackPanel></Border>
              <Border x:Name="MotorSequenceSection" Style="{StaticResource Card}" Padding="16"><StackPanel>
                <TextBlock Text="Chuỗi tự động theo thời gian" Style="{StaticResource Title}"/>
                <TextBlock Text="Thiết lập tổ hợp phía trên, nhập thời gian rồi thêm bước. Bấm Chạy chuỗi để thực hiện một lượt; hết chuỗi sẽ dừng cả 4 motor." Style="{StaticResource Muted}" FontSize="12"/>
                <WrapPanel>
                  <TextBlock Text="Thời gian bước (giây)" VerticalAlignment="Center" Margin="0,0,10,8"/>
                  <TextBox x:Name="StepDuration" Text="1.0" Width="75" Margin="0,0,12,8"/>
                  <Button x:Name="AddMotorStep" Content="+ Thêm từ tổ hợp" Padding="12,8"/>
                  <Button x:Name="MoveStepUp" Content="↑" Padding="12,8"/>
                  <Button x:Name="MoveStepDown" Content="↓" Padding="12,8"/>
                  <Button x:Name="RemoveMotorStep" Content="Xóa bước" Padding="12,8"/>
                  <Button x:Name="ClearMotorSteps" Content="Xóa chuỗi" Padding="12,8"/>
                </WrapPanel>
                <ListBox x:Name="MotorSteps" Background="#0D1420" Foreground="#DDE8F8" BorderBrush="#34445A" MinHeight="70" MaxHeight="180" Margin="0,0,0,12" FontFamily="Consolas" FontSize="12"/>
                <WrapPanel><Button x:Name="RunMotorSequence" Content="▶  Chạy chuỗi" Style="{StaticResource Primary}"/><Button x:Name="StopMotorSequence" Content="Dừng chuỗi"/><TextBlock x:Name="MotorSequenceStatus" Text="Chưa có bước nào · tối đa 20 bước, mỗi bước 0,1–30 giây" VerticalAlignment="Center" Margin="6,0,0,8" TextWrapping="Wrap"/></WrapPanel>
                <TextBlock Text="Đổi cửa sổ, đổi tab hoặc mất kết nối sẽ dừng và hủy chuỗi. Thời gian là thời gian giữ lệnh; motor vẫn tăng/giảm tốc và nghỉ khi đảo chiều theo firmware." Style="{StaticResource Muted}" FontSize="11"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
                <UniformGrid Columns="4">
                  <StackPanel><TextBlock Text="TRẠNG THÁI" Foreground="#8D9FB6" FontSize="10"/><TextBlock x:Name="RobotState" Text="OFFLINE" FontSize="20" FontWeight="Bold" Margin="0,7,0,10"/></StackPanel>
                  <StackPanel><TextBlock Text="NGUỒN PIN" Foreground="#8D9FB6" FontSize="10"/><TextBlock x:Name="Battery" Text="Chưa có số đo" Margin="0,7,0,10"/></StackPanel>
                  <StackPanel><TextBlock Text="PSRAM TRỐNG" Foreground="#8D9FB6" FontSize="10"/><TextBlock x:Name="Memory" Text="—" Margin="0,7,0,10"/></StackPanel>
                  <StackPanel><TextBlock Text="THỜI GIAN CHẠY" Foreground="#8D9FB6" FontSize="10"/><TextBlock x:Name="Uptime" Text="—" Margin="0,7,0,10"/></StackPanel>
                </UniformGrid>
                <TextBlock x:Name="StateReason" Text="Chưa kết nối ESP32." Style="{StaticResource Muted}"/>
                <UniformGrid Columns="4">
                  <StackPanel Margin="0,0,16,0"><TextBlock x:Name="MotorLFText" Text="M1   —" FontSize="12"/><ProgressBar x:Name="MotorLF"/></StackPanel>
                  <StackPanel Margin="0,0,16,0"><TextBlock x:Name="MotorLRText" Text="M2   —" FontSize="12"/><ProgressBar x:Name="MotorLR"/></StackPanel>
                  <StackPanel Margin="0,0,16,0"><TextBlock x:Name="MotorRFText" Text="M3   —" FontSize="12"/><ProgressBar x:Name="MotorRF"/></StackPanel>
                  <StackPanel><TextBlock x:Name="MotorRRText" Text="M4   —" FontSize="12"/><ProgressBar x:Name="MotorRR"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="Mức ra lệnh sau giới hạn firmware, chưa phải tốc độ đo. M1–M4 tương ứng các kênh LF, LR, RF, RR cũ." Style="{StaticResource Muted}" FontSize="11"/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>
          <Grid x:Name="ArmsPage" Visibility="Collapsed">
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Hai cánh tay độc lập" Style="{StaticResource Title}"/>
                <TextBlock Text="Giới hạn góc lấy từ firmware. Hiển thị góc ra lệnh; servo hiện tại không có cảm biến phản hồi." Style="{StaticResource Muted}"/>
                <CheckBox x:Name="ArmsClear" Content="Đã hiệu chuẩn và xác nhận hai tay không vướng cơ khí."/>
                <WrapPanel><Button x:Name="ServoOn" Content="Bật hai servo" Style="{StaticResource Primary}"/><Button x:Name="ServoOff" Content="Ngắt xung servo"/><Button x:Name="ArmsHome" Content="Về vị trí mặc định"/></WrapPanel>
              </StackPanel></Border>
              <UniformGrid Columns="2">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tay trái" Style="{StaticResource Title}"/><TextBlock x:Name="LeftAngle" Text="90°" FontSize="42" Foreground="#F4C348"/><Slider x:Name="LeftArm" Minimum="60" Maximum="120" Value="90" TickFrequency="1" IsSnapToTickEnabled="True"/><WrapPanel><Button x:Name="LeftDown" Content="Hạ trái"/><Button x:Name="LeftUp" Content="Nâng trái"/></WrapPanel><TextBlock x:Name="LeftRange" Text="Giới hạn: chờ cấu hình" Style="{StaticResource Muted}"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tay phải" Style="{StaticResource Title}"/><TextBlock x:Name="RightAngle" Text="90°" FontSize="42" Foreground="#F4C348"/><Slider x:Name="RightArm" Minimum="60" Maximum="120" Value="90" TickFrequency="1" IsSnapToTickEnabled="True"/><WrapPanel><Button x:Name="RightDown" Content="Hạ phải"/><Button x:Name="RightUp" Content="Nâng phải"/></WrapPanel><TextBlock x:Name="RightRange" Text="Giới hạn: chờ cấu hình" Style="{StaticResource Muted}"/></StackPanel></Border>
              </UniformGrid>
              <Border Style="{StaticResource Card}"><WrapPanel><Button x:Name="BothUp" Content="Nâng cả hai" Style="{StaticResource Primary}"/><Button x:Name="BothDown" Content="Hạ cả hai"/><TextBlock x:Name="ServoStatus" Text="SERVO ĐANG KHÓA" VerticalAlignment="Center" Foreground="#9DAFC5" Margin="15,0,0,8"/></WrapPanel></Border>
            </StackPanel>
          </Grid>
          <Grid x:Name="EyesPage" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Biểu cảm của WALL-E" Style="{StaticResource Title}"/>
                <TextBlock Text="Xem trước trên máy tính. Lệnh hiển thị được gửi khi đã nhận quyền và LCD được bật." Style="{StaticResource Muted}"/>
                <Border Background="#070D15" CornerRadius="18" Padding="25" Margin="0,10,0,18">
                  <Canvas Width="280" Height="100" HorizontalAlignment="Center">
                    <Canvas x:Name="EyeGroup" Width="280" Height="100">
                      <Rectangle x:Name="EyeLeft" Canvas.Left="35" Canvas.Top="20" Width="82" Height="60" RadiusX="20" RadiusY="20" Fill="#55D7EF"/>
                      <Rectangle x:Name="EyeRight" Canvas.Left="163" Canvas.Top="20" Width="82" Height="60" RadiusX="20" RadiusY="20" Fill="#55D7EF"/>
                    </Canvas>
                  </Canvas>
                </Border>
                <TextBlock x:Name="ExpressionLabel" Text="Bình thường · xem trước" Foreground="#55D7EF" Margin="0,0,0,14"/>
                <UniformGrid x:Name="ExpressionButtons" Columns="3"/>
                <TextBlock Text="Hướng nhìn ngang" Margin="0,12,0,0"/><Slider x:Name="LookX" Minimum="-100" Maximum="100" Value="0"/>
                <TextBlock Text="Hướng nhìn dọc"/><Slider x:Name="LookY" Minimum="-100" Maximum="100" Value="0"/>
                <CheckBox x:Name="Blink" Content="Tự chớp mắt" IsChecked="True"/>
                <TextBlock Text="Độ sáng màu mắt"/><Slider x:Name="Brightness" Value="80"/>
                <TextBlock x:Name="LcdStatus" Text="LCD chưa được bật trong cấu hình." Style="{StaticResource Muted}"/>
              </StackPanel></Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Âm thanh" Style="{StaticResource Title}"/>
                <TextBlock Text="INMP441 + MAX98357A" Style="{StaticResource Muted}"/>
                <TextBlock Text="Âm lượng"/><Slider x:Name="Volume" Value="20"/>
                <WrapPanel><Button x:Name="Tone" Content="Thử loa" Style="{StaticResource Primary}"/><Button x:Name="AudioStop" Content="Dừng âm thanh"/></WrapPanel>
                <TextBlock Text="Mức tín hiệu micro" Margin="0,18,0,4"/><ProgressBar x:Name="MicPeak" Maximum="32768" Height="12"/>
                <TextBlock x:Name="MicStatus" Text="Chưa thu âm" Style="{StaticResource Muted}"/>
                <WrapPanel><Button x:Name="MicStart" Content="Bật thu micro"/><Button x:Name="MicStop" Content="Dừng thu"/></WrapPanel>
                <TextBlock x:Name="AudioStatus" Text="Âm thanh chưa được bật trong cấu hình." Style="{StaticResource Muted}"/>
                <TextBlock Text="Thu âm và phát âm thanh cần ngoại vi đã đấu đúng. Chưa tích hợp AI hội thoại." Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>
          <Grid x:Name="AiPage" Visibility="Collapsed">
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="WALL-E nghe và trả lời" Style="{StaticResource Title}"/>
                <TextBlock Text="Micro trên robot → Wi-Fi → OpenAI → loa trên robot. Sau khi cấu hình, chỉ cần cấp nguồn và Wi-Fi có Internet; không cần laptop. Giọng nói do AI tạo." Style="{StaticResource Muted}"/>
                <TextBlock x:Name="AiStatus" Text="Cần nạp firmware 2.2 và kết nối USB để cấu hình." FontSize="17" Foreground="#F4C348" Margin="0,4,0,10" TextWrapping="Wrap"/>
                <TextBlock x:Name="AiNetwork" Text="Chưa có trạng thái Wi-Fi." Style="{StaticResource Muted}"/>
                <WrapPanel><Button x:Name="AiResume" Content="Bật nghe AI" Style="{StaticResource Primary}"/><Button x:Name="AiPause" Content="Tạm dừng nghe"/></WrapPanel>
                <TextBox x:Name="AiReply" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="75" MaxHeight="180" Text="Câu trả lời sẽ xuất hiện ở đây khi đang kết nối USB."/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="1. Wi-Fi của robot" Style="{StaticResource Title}"/>
                <TextBlock Text="Dùng Wi-Fi 2.4 GHz có Internet. Trả quyền điều khiển trước khi lưu." Style="{StaticResource Muted}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Tên Wi-Fi (SSID)"/><TextBox x:Name="AiSsid" MaxLength="32"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Mật khẩu Wi-Fi · để trống để giữ mật khẩu đã lưu"/><PasswordBox x:Name="AiWifiPassword" MaxLength="63" Background="#0D1420" Foreground="White" Padding="10,8" Margin="0,5,0,12"/></StackPanel>
                </Grid>
                <WrapPanel><CheckBox x:Name="AiAudioEnabled" Content="Tôi đã đấu micro và loa; bật âm thanh" Margin="0,8,25,14"/><CheckBox x:Name="AiMicRight" Content="Micro ở kênh phải (L/R nối 3V3)"/></WrapPanel>
                <TextBlock Text="Micro INMP441: BCLK 17, WS 18, SD 21. MAX98357A: BCLK 17, WS 18, DIN 39. L/R nối GND là kênh trái." Style="{StaticResource Muted}" FontSize="12"/>
                <Button x:Name="AiSaveWifi" Content="Lưu Wi-Fi &amp; âm thanh" HorizontalAlignment="Left"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="2. Kết nối OpenAI" Style="{StaticResource Title}"/>
                <TextBlock Text="Nhập API key mới trực tiếp tại đây. Key được gửi qua USB và lưu trên ESP32; không ghi vào mã nguồn hay nhật ký GUI. Sử dụng API có tính phí theo tài khoản OpenAI." Style="{StaticResource Muted}"/>
                <TextBlock x:Name="AiKeyStatus" Text="Chưa đọc cấu hình AI." Style="{StaticResource Muted}"/>
                <PasswordBox x:Name="AiApiKey" MaxLength="255" Background="#0D1420" Foreground="White" Padding="10,8" Margin="0,0,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0"><TextBlock Text="Model Realtime"/><TextBox x:Name="AiModel" Text="gpt-realtime-2.1-mini" MaxLength="63"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Giọng nói"/><TextBox x:Name="AiVoice" Text="marin" MaxLength="15"/></StackPanel>
                </Grid>
                <TextBlock x:Name="AiThresholdLabel" Text="Ngưỡng nhận giọng: 250"/>
                <Slider x:Name="AiThreshold" Minimum="50" Maximum="5000" Value="250" TickFrequency="50" IsSnapToTickEnabled="True"/>
                <TextBlock Text="Tăng ngưỡng nếu tiếng ồn làm robot tự trả lời; giảm nếu robot khó nghe. Mỗi câu tối đa 12 giây. Robot chờ khoảng 0,8 giây im lặng rồi trả lời." Style="{StaticResource Muted}" FontSize="12"/>
                <WrapPanel><CheckBox x:Name="AiEnabled" Content="Tự nghe AI sau khi bật nguồn" Margin="0,8,30,14"/><CheckBox x:Name="AiEraseKey" Content="Xóa API key đã lưu"/></WrapPanel>
                <WrapPanel><Button x:Name="AiSave" Content="Lưu cấu hình AI" Style="{StaticResource Primary}"/><Button x:Name="AiReboot" Content="Khởi động lại để áp dụng"/></WrapPanel>
                <TextBlock Text="Sau khi lưu cả hai phần, khởi động lại rồi trả quyền điều khiển để robot tự nghe. Khi bạn nhận quyền điều khiển motor/servo, AI tự tạm dừng." Style="{StaticResource Muted}"/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>
          <Grid x:Name="SettingsPage" Visibility="Collapsed">
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Cấu hình phần cứng" Style="{StaticResource Title}"/>
                <TextBlock Text="Dừng và trả quyền trước khi lưu. Sau khi lưu, khởi động lại để áp dụng. GUI không tự bật phần cứng." Style="{StaticResource Muted}"/>
                <CheckBox x:Name="HardwareConfirmed"><TextBlock Text="Tôi đã kiểm tra sơ đồ GPIO, nguồn và cơ cấu robot thực tế." TextWrapping="Wrap"/></CheckBox>
                <WrapPanel><CheckBox x:Name="LcdEnabled" Content="Bật LCD" Margin="0,8,30,14"/><CheckBox x:Name="AudioEnabled" Content="Bật âm thanh" Margin="0,8,30,14"/><CheckBox x:Name="BatteryEnabled" Content="Đã có mạch đo pin"/></WrapPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,24,0"><TextBlock x:Name="LimitLabel" Text="Giới hạn PWM motor: 25%"/><Slider x:Name="MotorLimit" Minimum="5" Maximum="80" Value="25" TickFrequency="1" IsSnapToTickEnabled="True"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Tỷ số chia áp pin (đã hiệu chuẩn)"/><TextBox x:Name="BatteryRatio" Text="4.0"/><TextBlock Text="Ví dụ 100kΩ / 33kΩ: khoảng 4.0303." Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </Grid>
                <WrapPanel><Button x:Name="ReloadSettings" Content="Đọc lại từ ESP32"/><Button x:Name="SaveSettings" Content="Lưu cấu hình" Style="{StaticResource Primary}"/><Button x:Name="Reboot" Content="Khởi động lại ESP32"/></WrapPanel>
                <TextBlock x:Name="ConfigStatus" Text="Chưa có cấu hình từ ESP32." Style="{StaticResource Muted}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel>
                <TextBlock Text="Chẩn đoán &amp; thông báo" Style="{StaticResource Title}"/>
                <TextBlock x:Name="Modules" Text="Kết nối ESP32 để đọc trạng thái các module." Style="{StaticResource Muted}"/>
                <TextBox x:Name="EventLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="160" FontFamily="Consolas" FontSize="12" Text="WALL-E Control sẵn sàng."/>
                <TextBlock x:Name="UploadStatus" Text="" Style="{StaticResource Muted}"/>
              </StackPanel></Border>
            </StackPanel>
          </Grid>
        </Grid>
      </ScrollViewer>
      <DockPanel Grid.Row="4" Margin="0,5,16,0"><TextBlock Text="WALL-E CONTROL  /  USB" FontSize="10" Foreground="#647C9A"/><TextBlock x:Name="Footer" Text="Chưa kết nối · Chuyển động đang khóa" FontSize="10" Foreground="#8FA3BD" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
  </Grid>
</Window>
